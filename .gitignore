# ==========================================
# 根目录 Markdown 文档（按规范忽略根目录下所有 md 文件）
# ==========================================
/*.md

# ==========================================
# 编译与构建产物 (Maven / Java)
# ==========================================
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ==========================================
# 前端构建与依赖 (Node / Vite)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.output/
frontend/.vite/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# IDE 与编辑器配置
# ==========================================
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# ==========================================
# 本地工具与环境缓存
# ==========================================
.tools/

# ==========================================
# 数据文件、临时文件与快照备份
# ==========================================
data/
*.tmp
*.bak
*.log

# ==========================================
# 操作系统缓存
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
